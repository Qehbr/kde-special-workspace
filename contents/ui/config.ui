<ui version="4.0">
 <class>KWin::SpecialWorkspaceConfigForm</class>
 <widget class="QWidget" name="KWin::SpecialWorkspaceConfigForm">
  <property name="geometry"><rect><x>0</x><y>0</y><width>640</width><height>620</height></rect></property>
  <layout class="QVBoxLayout" name="layout_root">
   <item><widget class="QLabel" name="label_reload_notice">
    <property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;&lt;b&gt;Changes take effect after the script is reloaded.&lt;/b&gt; Press OK or Apply here, then go back to the KWin Scripts list, untick &lt;b&gt;Special Workspace&lt;/b&gt;, press Apply, tick it again and press Apply. KWin gives scripts no way to be notified when their settings change, so this step cannot be done for you.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property>
    <property name="textFormat"><enum>Qt::RichText</enum></property>
    <property name="wordWrap"><bool>true</bool></property>
    <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
    <property name="margin"><number>8</number></property>
   </widget></item>
   <item><widget class="QTabWidget" name="tabWidget">
    <property name="currentIndex"><number>0</number></property>
    <widget class="QWidget" name="tab_general">
      <attribute name="title"><string>General</string></attribute>
      <layout class="QVBoxLayout" name="layout_general">
       <item><widget class="QGroupBox" name="group_slots_count">
        <property name="title"><string>Slots</string></property>
        <layout class="QGridLayout" name="grid_slotcount">
         <item row="0" column="0"><widget class="QLabel" name="label_auto_1"><property name="text"><string>Number of slots:</string></property></widget></item>
         <item row="0" column="1"><widget class="QSpinBox" name="kcfg_slotCount"><property name="minimum"><number>1</number></property><property name="maximum"><number>12</number></property><property name="value"><number>4</number></property></widget></item>
         <item row="1" column="0" colspan="2"><widget class="QLabel" name="label_auto_2"><property name="text"><string>Each slot gets its own toggle shortcut. Raising this is always safe. Before lowering it, clear the shortcuts of the slots you are dropping in System Settings &gt; Shortcuts &gt; KWin &#8212; a slot that is no longer registered vanishes from that list but keeps holding its key.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout></widget></item>
       <item><widget class="QGroupBox" name="group_size">
        <property name="title"><string>Size and placement</string></property>
        <layout class="QGridLayout" name="grid_size">
         <item row="0" column="0" colspan="2"><widget class="QLabel" name="label_auto_3"><property name="text"><string>How large a window becomes when a slot shows it. Individual slots can override these on the Slots tab.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item row="1" column="0"><widget class="QLabel" name="label_auto_4"><property name="text"><string>Width of a shown window:</string></property></widget></item>
         <item row="1" column="1"><widget class="QSpinBox" name="kcfg_widthRatio"><property name="minimum"><number>10</number></property><property name="maximum"><number>100</number></property><property name="value"><number>75</number></property><property name="suffix"><string> % of screen</string></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="label_auto_5"><property name="text"><string>Height of a shown window:</string></property></widget></item>
         <item row="2" column="1"><widget class="QSpinBox" name="kcfg_heightRatio"><property name="minimum"><number>10</number></property><property name="maximum"><number>100</number></property><property name="value"><number>83</number></property><property name="suffix"><string> % of screen</string></property></widget></item>
         <item row="3" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_placeWindows"><property name="text"><string>Resize and centre windows when showing them</string></property><property name="checked"><bool>true</bool></property></widget></item><item row="4" column="0" colspan="2"><widget class="QLabel" name="label_place_note"><property name="text"><string>Uncheck this if you use a tiling script such as Krohnkite: the window will be shown and focused, and the tiler decides where it goes. The width and height settings above, and the per-slot overrides, are then ignored.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item><item row="5" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_centerOnActiveScreen"><property name="text"><string>Always show on the screen that currently has focus</string></property><property name="checked"><bool>true</bool></property></widget></item>
         <item row="6" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_followCurrentDesktop"><property name="text"><string>Bring the window to the current virtual desktop when showing it</string></property><property name="checked"><bool>true</bool></property></widget></item>
        </layout></widget></item>
       <item><widget class="QGroupBox" name="group_hiding">
        <property name="title"><string>Hiding</string></property>
        <layout class="QGridLayout" name="grid_hiding">
         <item row="0" column="0"><widget class="QLabel" name="label_auto_6"><property name="text"><string>When a window is hidden:</string></property></widget></item>
         <item row="0" column="1"><widget class="QComboBox" name="kcfg_hideMode">
          <property name="currentIndex"><number>0</number></property>
          <item><property name="text"><string>Minimize it</string></property></item>
          <item><property name="text"><string>Minimize and park it on a virtual desktop</string></property></item>
         </widget></item>
         <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="kcfg_hideFromTaskbar"><property name="text"><string>Also hide it from the task manager and pager</string></property><property name="checked"><bool>true</bool></property></widget></item>
         <item row="2" column="0"><widget class="QLabel" name="label_auto_7"><property name="text"><string>Parking desktop:</string></property></widget></item>
         <item row="2" column="1"><widget class="QSpinBox" name="kcfg_specialDesktop"><property name="minimum"><number>-1</number></property><property name="maximum"><number>19</number></property><property name="value"><number>-1</number></property></widget></item>
         <item row="3" column="0" colspan="2"><widget class="QLabel" name="label_auto_8"><property name="text"><string>Parking desktop is 0-based; -1 means the last one. It needs at least two virtual desktops and is ignored otherwise. Only used by the second hiding mode.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout></widget></item>
       <item><widget class="QGroupBox" name="group_feedback">
        <property name="title"><string>Feedback</string></property>
        <layout class="QVBoxLayout" name="layout_feedback">
         <item><widget class="QCheckBox" name="kcfg_showOsd"><property name="text"><string>Show an on-screen message when a slot has no matching window</string></property><property name="checked"><bool>true</bool></property></widget></item>
        </layout></widget></item>
       <item><spacer name="spacer_general"><property name="orientation"><enum>Qt::Vertical</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
      </layout></widget>
    <widget class="QWidget" name="tab_slots">
      <attribute name="title"><string>Slots</string></attribute>
      <layout class="QVBoxLayout" name="layout_slots">
       <item><widget class="QLabel" name="label_slots_help">
        <property name="text"><string>One row per slot. A slot with an empty matcher does nothing.

Matchers: bare text matches the window class or name, case-insensitively, as a substring. Prefix with class:, name: or title: to target one field, use * as a wildcard, re: for a regular expression, and | to accept several alternatives.

Examples:   spotify   |   class:org.kde.dolphin   |   title:*Scratch*   |   re:^kitty$   |   spotify|LM Studio

To find out what to type, bind the &quot;Show focused window's class&quot; shortcut under System Settings &gt; Shortcuts &gt; KWin, then press it while the window is focused.

A width or height of 0 means the slot uses the General defaults. Rows past the configured slot count have no shortcut and are inactive.</string></property>
        <property name="wordWrap"><bool>true</bool></property></widget></item>
       <item><layout class="QGridLayout" name="grid_slots"><item row="0" column="0"><widget class="QLabel" name="label_auto_9"><property name="text"><string>&lt;b&gt;Slot&lt;/b&gt;</string></property></widget></item><item row="0" column="1"><widget class="QLabel" name="label_auto_10"><property name="text"><string>&lt;b&gt;Window matcher&lt;/b&gt;</string></property></widget></item><item row="0" column="2"><widget class="QLabel" name="label_auto_11"><property name="text"><string>&lt;b&gt;Width&lt;/b&gt;</string></property></widget></item><item row="0" column="3"><widget class="QLabel" name="label_auto_12"><property name="text"><string>&lt;b&gt;Height&lt;/b&gt;</string></property></widget></item><item row="1" column="0"><widget class="QLabel" name="label_auto_13"><property name="text"><string>1</string></property></widget></item><item row="1" column="1"><widget class="QLineEdit" name="kcfg_slot1Matcher"><property name="placeholderText"><string>e.g. spotify</string></property></widget></item><item row="1" column="2"><widget class="QSpinBox" name="kcfg_slot1Width"><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="suffix"><string> %</string></property></widget></item><item row="1" column="3"><widget class="QSpinBox" name="kcfg_slot1Height"><property name="minimum"><number>0</number></property><property name="maximum"><number>100</number></property><property name="value"><number>0</number></property><property name="suffix"><string> %</string></property></widget></item><item row="2" column="0"><widget class="QLabel" name="label_auto_14"><property name="text"><string>2</string></property></widget></item><item row="2" column="1"><widget class="QLineEdit" name="kcfg_slot2Matcher"><property name="placeholderText"><string>e.g. spotify</string></property></widget></item><item row="2" column="2"><widget class="QSpinBox" name="kcfg_slot2Width"><property n