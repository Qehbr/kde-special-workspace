    <widget class="QWidget" name="tab_shortcuts">
      <attribute name="icon"><iconset theme="configure-shortcuts"/></attribute>
      <attribute name="title"><string>Shortcuts</string></attribute>
      <layout class="QVBoxLayout" name="layout_shortcuts">
       <item><widget class="QGroupBox" name="group_shortcuts">
        <property name="title"><string>Keyboard shortcuts</string></property>
        <layout class="QVBoxLayout" name="layout_sc_inner">
         <item><widget class="QLabel" name="label_sc_intro">
          <property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;p&gt;Each slot has one shortcut, and it works both ways: press it to show the slot&amp;#8217;s window, press it again to hide it.&lt;/p&gt;&lt;p&gt;Shortcuts are managed by Plasma&amp;#8217;s global shortcut system rather than by this dialog, so conflicts with your other shortcuts are detected. &lt;a href=&quot;systemsettings://kcm_keys&quot;&gt;Open Shortcuts settings&lt;/a&gt; and search for &lt;b&gt;Special Workspace&lt;/b&gt;.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string></property>
          <property name="textFormat"><enum>Qt::RichText</enum></property>
          <property name="openExternalLinks"><bool>true</bool></property>
          <property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><widget class="QLabel" name="label_sc_table">
          <property name="text"><string>&lt;html&gt;&lt;body&gt;&lt;table cellspacing=&quot;0&quot; cellpadding=&quot;4&quot;&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Toggle slot N&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;#8220;Special Workspace: Toggle slot N&amp;#8221;&lt;/td&gt;&lt;td&gt;Meta+F1&amp;#8211;F4 by default&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Identify a window&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;#8220;Special Workspace: Show focused window&amp;#8217;s class&amp;#8221;&lt;/td&gt;&lt;td&gt;unbound &amp;#8212; bind while setting up&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Restore everything&lt;/b&gt;&lt;/td&gt;&lt;td&gt;&amp;#8220;Special Workspace: Restore all hidden windows&amp;#8221;&lt;/td&gt;&lt;td&gt;unbound&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;</string></property>
          <property name="textFormat"><enum>Qt::RichText</enum></property>
          <property name="wordWrap"><bool>true</bool></property></widget></item>
        </layout></widget></item>
       <item><spacer name="spacer_sc"><property name="orientation"><enum>Qt::Vertical</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
      </layout></widget>
